
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #dbeafe, #e9d5ff);
    padding: 30px 15px;
}

.container {
    max-width: 550px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.15);
}

h1 {
    text-align: center;
    color: #4338ca;
    margin-bottom: 10px;
}

p {
    text-align: center;
    margin-bottom: 25px;
    color: #666;
}

h3 {
    color: #4338ca;
    margin: 20px 0 15px;
    border-bottom: 2px solid #ddd;
    padding-bottom: 8px;
}

label {
    display: block;
    margin: 12px 0 6px;
    font-weight: bold;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 7px;
    font-size: 15px;
}

input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: #6366f1;
}

textarea {
    resize: vertical;
    min-height: 90px;
}

.check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: normal;
}

.check input {
    width: auto;
}

button {
    width: 100%;
    padding: 14px;
    margin-top: 20px;
    border: none;
    border-radius: 8px;
    background: #4f46e5;
    color: white;
    font-size: 17px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #312e81;
    transform: translateY(-2px);
}

#message {
    margin-top: 20px;
    color: green;
    font-weight: bold;
}

@media (max-width: 480px) {
    .container {
        padding: 20px;
    }

    h1 {
        font-size: 23px;
    }
}
